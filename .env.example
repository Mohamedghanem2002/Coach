# إعدادات جلسة المصادقة والأمان
AUTH_SECRET=your_jwt_auth_secret_key_here

# اسم قاعدة البيانات
MONGODB_DB=coach_db

# رابط قاعدة بيانات MongoDB (اختياري - في حال تركه فارغاً سيعمل النظام تلقائياً بنظام التخزين المحلي الآمن)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# ========================================================
# إعدادات لوحة تحكم الإدارة العليا (Admin Control Panel)
# ========================================================
# البريد الإلكتروني للمدير العام (صاحب المنصة)
ADMIN_EMAIL=mg0447837@gmail.com

# كلمة المرور المبدئية لإنشاء حساب المدير إذا لم يكن موجوداً
ADMIN_PASSWORD=your_secure_admin_password_here

# البريد الذي ستصل إليه إشعارات تسجيل الأكاديميات الجديدة
ADMIN_NOTIFICATION_EMAIL=mg0447837@gmail.com

# ========================================================
# إعدادات إرسال البريد الإلكتروني وإشعارات المنصة (SMTP / Gmail)
# ========================================================
# خيار 1: إعدادات خادم SMTP مخصص
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=no-reply@example.com

# خيار 2: استخدام حساب Gmail (بديل اختياري)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_google_app_password
